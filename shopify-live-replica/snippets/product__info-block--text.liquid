{%- comment -%}
    Render text element using block settings

    Accepts:
     - block:      {Object}
     - blockOrder: {Number}
     - sectionId:  {String}
     - product:    {Object}
{%- endcomment -%}
{% liquid
    assign text = block.settings.text | strip
    assign class = 'product__info-block product__info-block--text rte reveal-item'

    if block.settings.no_spacing
        assign class = class | append: ' product__info-block-no-spacing'
    endif
%}
{%- unless text == blank -%}
    <text-expandable
        class="{{ class }} product__info-block--text-{{ block.settings.text_style }}"
        data-button-text-expand="{{ 'products.product._more' | t }}"
        data-button-text-narrow="{{ 'products.product._less' | t }}"
        data-expanded="{% if block.settings.is_collapsed %}false{% else %}true{% endif %}"
        style="order: {{ blockOrder }};{% if block.settings.is_collapsed %}--line-clamp:{{ block.settings.initial_lines }}{% endif %}"
        {{ block.shopify_attributes }}
    >
        {{- text -}}
    </text-expandable>
{%- endunless -%}
