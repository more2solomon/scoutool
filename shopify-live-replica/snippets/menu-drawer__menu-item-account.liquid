{%- if customer %}
    <details>
        <summary class="menu-drawer__menu-item list-menu__item list-menu__item--account">
            <span class="list-menu__item--inner">
                <svg aria-hidden="true" focusable="false" role="presentation" width="20" height="20" class="icon-user">
                    <use href="#icon-user" />
                </svg>
                <span class="account-label">
                    {{- customer.first_name }}
                    {{ customer.last_name -}}
                </span>
            </span>
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret">
                <use href="#icon-caret" />
            </svg>
        </summary>
        <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-submenu">
                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                    <li>
                        <a
                            href="{{ routes.account_url }}"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if false %} menu-drawer__menu-item--active{% endif %}"
                            {% if false %}
                                aria-current="page"
                            {% endif %}
                        >
                            <span>{{ 'customer.account_fallback' | t }}</span>
                        </a>
                    </li>
                    <li>
                        <a
                            href="{{ routes.account_logout_url }}"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if false %} menu-drawer__menu-item--active{% endif %}"
                            {% if false %}
                                aria-current="page"
                            {% endif %}
                        >
                            <span>{{ 'customer.log_out' | t }}</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </details>
{% else %}
    <a
        href="{{ routes.account_login_url }}"
        class="menu-drawer__menu-item list-menu__item list-menu__item--account"
        title="{{ 'customer.log_in' | t }}"
    >
        <span class="list-menu__item--inner">
            <svg aria-hidden="true" focusable="false" role="presentation" width="20" height="20" class="icon-user">
                <use href="#icon-user" />
            </svg>
            <span>{{ 'customer.log_in' | t }}</span>
        </span>
    </a>
{% endif -%}
