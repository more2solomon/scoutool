{%- comment -%}
    Headings style applied

    Accepts:
    - heading {String}
{%- endcomment -%}

{%- liquid
    assign heading = heading
    assign words = heading | split: ' '
    assign headingStyle = settings.bold_first_heading_word

    if words.size > 1 and headingStyle
        for word in words
            if forloop.first
                echo '<b>'
            endif
            if forloop.last
                echo '</b><span class="highlight-last-word">'
            endif
            echo word | append: ' </span>'
        endfor
    else
        if settings.enable_bold_headings
            echo '<strong>'
        endif
        echo heading
        if settings.enable_bold_headings
            echo '</strong>'
        endif
    endif
-%}
