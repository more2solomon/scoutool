{%- liquid
    render 'icons-charge', name: 'cart'

    assign cart_bubble_class = 'cart-count-bubble'
    if settings.current_presets == 'gorpcore'
        assign cart_bubble_class = cart_bubble_class | append: ' with__no-count'
    else
        assign cart_bubble_class = cart_bubble_class | append: ' with__count'
    endif
-%}
<span class="cart-label">
    {{ 'templates.cart.cart' | t }}
    {% comment %}
        {%- if cart == empty -%}
          {{ 'templates.cart.cart' | t }}
        {%- else -%}
          {{ 'sections.header.cart_count' | t: count: cart.item_count }}
        {%- endif -%}
    {% endcomment %}
</span>
<div class="{{ cart_bubble_class }}">
    {%- if cart.item_count > 0 -%}
        <span aria-hidden="true">{{ cart.item_count }}</span>
    {%- endif -%}
</div>
<svg aria-hidden="true" focusable="false" role="presentation" width="19" height="19" class="icon-x">
    <use href="#icon-x" />
</svg>
