<link
    rel="stylesheet"
    href="{{ 'section-navigation-megamenu.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
>
<link
    rel="stylesheet"
    href="{{ 'section-navigation-smallmenu.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
>
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'disclosure.css' | asset_url }}" media="print" onload="this.media='all'">

{%- liquid
    assign sectionId = section.id | prepend: '#shopify-section-'

    case settings.show_search_icon
        when 'all_screens'
            assign searchLayout = 'icon'
        when 'mobile_only'
            assign searchLayout = 'icon__mobile-only'
        else
            assign searchLayout = 'expanded'
    endcase

    assign _header_class_ = 'header'
    if section.settings.full_width
        assign _header_class_ = _header_class_ | append: ' full--width'
    else
        assign _header_class_ = _header_class_ | append: ' header--dynamic-page-width'
    endif

    if section.settings.menu != blank
        assign _header_class_ = _header_class_ | append: ' header--has-menu'
    endif

    assign _header_class_ = _header_class_ | append: ' logo--' | append: settings.logo_position
    assign _header_class_ = _header_class_ | append: ' search--' | append: searchLayout
    assign _header_class_ = _header_class_ | append: ' search-icon__position-' | append: settings.search_icon_position

    assign current_type_menu = section.settings.type_menu
    assign _header_class_ = _header_class_ | append: ' ' | append: current_type_menu | append: '-menu'

    if settings.show_login_icon_on_mobile
        assign _header_class_ = _header_class_ | append: ' with--login-icon-onmobile'
    endif

    # use item menu as phone number link
    assign phone_number_icon_width = 18
    assign selected_item_menu_as_phone_link = section.settings.item_menu_name | escape | downcase
-%}

{% style %}
    :where(header) {
      --header--dropdown-background: {{ settings.colors_header_dd_background }};
      --header--dropdown-color: {{ settings.colors_header_dd_text }};
      --header--dropdown-color-rgb: {{ settings.colors_header_dd_text.red }}, {{ settings.colors_header_dd_text.green }}, {{ settings.colors_header_dd_text.blue }};
      --header--dropdown-third--level-background: {{ settings.colors_header_dd_third_level_background }};
      --header--dropdown-third--level-color: {{ settings.colors_header_dd_third_level_text }};
      --header--item-highlighted-foreground: {{ settings.colors_header_item_highlighted_foreground }};
      --header--active-item-highlighted-foreground: {{ settings.colors_header_hover_item_highlighted_foreground }};
      --header--item-highlighted-background: {{ settings.colors_header_item_highlighted_background_gradient | default: settings.colors_header_item_highlighted_background }};
      --header--dividers-color: {{ settings.colors_navigation_divider }};
      --header--menu-item--active--text-color: #E13124;
      --search--button--background-color: {{ settings.colors_search_button_background_gradient | default: settings.colors_search_button_background }};
      --search__background-color: {{ settings.colors_search_field_background }};
      --search-placeholder-color: {{ settings.colors_search_placeholder_color }};
      --search--input--text-color:{{ settings.colors_search_field_text}};
    }
{% endstyle %}

{% style %}
    .header--dynamic-page-width {
        padding-left: .75rem;
        padding-right: .75rem;
    }

    .header-wrapper {
        position: relative;
        z-index: 99;
        background: var(--header--background-color);
        display: block;
    }

    .header {
        display: grid;
        align-items: center;
        color: var(--header--text-color);
        padding-top: .75rem;
        padding-bottom: .75rem;
        grid-template-columns: auto 1fr;
    }

    .header.logo--middle.search-icon__position-left .header__search {
        grid-area: search-left;
    }

    .header.logo--middle.search-icon__position-right .header__search {
        grid-area: search;
    }

    .header.combined-menu:not(:has(header-menu)),
    .header.slideout-menu:not(:has(header-menu)) {
        padding-bottom: .75rem;
    }

    .header.search--expanded {
        grid-template-areas:'heading heading heading'
                            'menu_drawer search-left icons';
        grid-template-columns: auto auto 1fr;
    }

    .header.search--expanded.search-icon__position-left {
        grid-template-columns: auto 1fr;
    }

    .header.search--icon {
        grid-template-areas:'menu_drawer heading search-left icons';
    }

    header-drawer {
        justify-self: start;
    }

    .header__heading {
        grid-area: heading;
        display: flex;
        color: currentColor;
        margin: 0;
    }

    .header__heading-link {
        grid-area: heading;
        position: relative;
        z-index: 31;
        display: flex;
        justify-self: center;
        padding: 0 .75rem;
        text-decoration-line: none;
        overflow-wrap: break-word;
        margin-bottom: 1rem;
    }{% if section.settings.logo == blank or section.settings.dislay_shopname_on_mobile %}

    .header__heading-link .h3 {
        color: currentColor;
        font-style: italic;
        font-weight: normal;
        margin: 0;
        word-break: break-all;
    }

    .header__heading-link strong {
        color: var(--color-base-accent-1);
    }{% endif %}

    .header__icons {
        align-items: center;
        grid-area: icons;
        display: flex;
        gap: .25rem;
        justify-content: end;
        width: auto;
    }

    .switcher-language__left .disclosure__list--wrapper::after {
        top: -.25rem;{% unless request.locale.iso_code contains 'ar' %}
        right: unset;
        left: 1rem;{% endunless %}
        z-index: -1;
    }

    .header__inline-menu {
        grid-area: navigation;
        display: none;
    }

    .switcher-language__left .localization-selector,
    .header__icons .localization-selector,
    .header__icon {
        --color-button-background: none;
        --color-button-border: transparent;
        --color-button-text: var(--header--text-color);
        border-width: 1px;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.5rem;
    }
    {% if settings.current_presets == 'garage' %}
    .header__icon--summary {
        --color-button-text: var(--color-base-accent-2);
    }{% endif %}

    .header__icon .icon-x {
        display: none;
    }

    .header__icon--menu {
        padding: .5rem;
    }

    .header__icon--cart {
        align-items: center;
        display: flex;
        gap: .5rem;
        min-width: auto;
        padding: .5rem .6rem .5rem .4rem;
    }

    .cart-label,
    .cart-count-bubble {
        display: none;
    }

    .search__button {
        --color-button-border: var(--search--button--background-color);
        --color-button-background: var(--search--button--background-color);
        --color-button-text: var(--color-base-accent-1-inverse);
        min-width: auto;
    }

    .search__button svg {
        height: 1.5rem;
        width: 1.5rem;
    }

    .search__input,
    :is(filter-category) .search-filter-wrapper > button {
        background-color: var(--search__background-color);
        color: var(--search--input--text-color);
        /* override Safari rouded corners on input field */
        -webkit-appearance: none;
    }

    .header__search,
    .header__search form {
        position: relative;
        width: 100%;
        z-index: 40;
    }

    .header__search .field {
        margin: 0;{% if section.settings.add_border_searchfield and settings.show_search_icon == 'none' %}
        box-shadow: 0 0 0 2px var(--header--background-color), 0 0 0 3px rgba(var(--header--text-color-rgb), .3);
        background: var(--header--background-color);{% endif %}
    }

    .header__search .search__button {
        border: 0;
    }

    /* Separate selector for search field in header becuase search field can appear at search result page */
    .header__search .search__input {
        padding-right: 3rem;{% if settings.use_elements_border_radius == false %}
        border: 0{% endif %};
    }{%- if localization.available_languages.size > 1  or localization.available_countries.size > 1 -%}

    .header__icons .localization-currency-wrapper,
    .header__icons .localization-language-wrapper {
        display: none;
    }

    header .language-icon__wrapper {
        --switcher-icon-width: 24px;
        margin-right: .25rem;
    }

    .language-icon__wrapper {
        align-items: center;
        border-radius: 100%;
        display: flex;
        flex-shrink: 0;
        justify-content: center;
        overflow: hidden;
        width: var(--switcher-icon-width);
        height: var(--switcher-icon-width);
    }

    .language-icon__wrapper i {
        font-size: 2rem;
        font-style: normal;
        vertical-align: top;
    }{%- endif -%}{% if section.settings.show_overlay %}
    .header-menu__overlay-element.shown {
        background: rgba(0,0,0,{{ settings.overlay_transparenty }});{% if settings.enable_overlay_blur %}
        backdrop-filter: blur({{ settings.overlay_blur | times: 10 | append: 'px' }});{% endif %}
    }{% endif %}{% if localization.available_languages.size > 1  or localization.available_countries.size > 1 %}

    .localization-form__currency {
        white-space: nowrap;
    }{% endif %}

    @media (max-width: 500px), print {
        .header__heading :is(img) {
            max-width: {{ section.settings.mobile_logo_width }}px;
        }
        {%- if settings.show_login_icon_on_mobile -%}
        .header__buttons--wrapper,
        .header__icon--account {
            display: flex;
            min-width: auto;
        }

        .header.search--icon .predictive-search {
            right: -1rem;
        }

        header.header .header__heading-link {
            padding: 0;
        }

        .header .button.header__icon {
            padding: .5rem;
        }

        .header__icon--account > span,
        #menu-drawer .item--account {
            display: none;
        }{% else %}

        .header__icon--account {
            display: none;
        }{%- endif -%}
    }

    @media (max-width: 989px), print {
        .header-wrapper {
            position: relative;
        }
        {%- if section.settings.center_logo_on_mobile -%}
        .header.logo--left .header__heading,
        .header__heading {
            justify-content: center;
        }
        {% endif %}
        .header__search,
        .header__search form {
            z-index: 31;
        }

        .switcher-language__left {
            display: none;
        }
    }

    @media (min-width: 750px), print {
        .header.logo {
            grid-template-columns: 15rem auto;
        }

        .header__heading :is(img) {
            max-width: {{ section.settings.logo_width }}px;
        }

        .header.logo--left .header__heading {
            justify-content: center;
        }

        .header__heading-link {
            margin-right: .25rem;
        }

        .account-label,
        .cart-label {
            display: inline;
            white-space: nowrap;
        }

        .dropdown-inner:not(.small) summary {
            padding-left: 0;
        }

        .header__submenu .image--link {
            font-size: 1rem;
            color: var(--color-foreground);
            font-weight: bold;
            margin-top: 0.75rem;
        }

        .header__submenu .media:hover ~ .image--link {
            color: var(--color-foreground-75);
        }

        .header__icon--account > svg {
            height: 1.25rem;
        }{% if settings.current_presets == 'gorpcore' %}

        .header__icon > svg,
        .header__icons .icon-caret {
            color: var(--header--text-color-rgb);
        }{% else %}

        .header__icon > svg,
        .header__icons .icon-caret {
            --icons__color-rgba: rgba(var(--header--text-color-rgb), .6);
            color: var(--icons__color-rgba);
        }{% endif %}

        .header__buttons--wrapper {
            display: flex;
            gap: 0;
            align-items: center;
        }{% if shop.customer_accounts_enabled %}

        .header__icon--account {
            display: inline-flex;
            min-width: auto;
            gap: .25rem;
        }{% endif %}{% if section.settings.show_icons_line_divider %}

        .header__buttons--wrapper > * {
            border-right: 1px solid var(--header--dividers-color);
            border-radius: 0;
            -webkit-border-radius: 0;
        }

        .header__buttons--wrapper > .header__icon--cart,
        .header__buttons--wrapper > cart-sidebar {
            border-right: none;
        }{% endif %}
    }

    @media (min-width: 990px), print {
        .header--dynamic-page-width {
            max-width: {{ section.settings.header_max_width }}px;
            margin: 0 auto;
        }

        .header__inline-menu:before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            background: {{ settings.colors_navigation_background }};
            height: 100%;
            max-height: 45px;
            z-index: -1;
        }

        .header {
            padding-bottom: 0;{% unless section.settings.type_menu == 'slideout' %}
            padding-top: 1.25rem;{% endunless %}
            {%- if section.settings.menu == blank -%}
            padding-bottom: 1.25rem{%- endif -%};
        }

        .header.logo--left .header__heading,
        .header__heading {
            justify-content: {{ section.settings.justify_logo }};
        }
        {%- if section.settings.show_header_line_divider -%}
        .header_line--divider {
            grid-area: line_divider;
            position: absolute;
            display: flex !important;
            left: 0;
            right: 0;
        }

        .header_line--divider:after {
            content: '';
            width: 100%;
            height: 1px;
            background: var(--header--dividers-color);
            margin-top: -1rem;
        }

        [data-theme-preset="metalware"] .header_line--divider:after {
            max-width: {{ section.settings.header_max_width }}px;
            margin: 0 auto;
            margin-top: -.5rem;
        }
        {% endif %}

        .logo--middle.search--icon.search-icon__position-left .search--icon .field__button,
        .logo--middle.search--icon.search-icon__position-left .search__input{
            right: unset;
        }
        {% if section.settings.type_menu == 'slideout' or section.settings.type_menu == 'combined' %}
        header-drawer {
            grid-area: menu_drawer;
            padding: .5rem 0;
        }

        header-drawer + .header__heading {
            margin-left: 1rem;
        }

        header-drawer .localization-currency-wrapper,
        header-drawer .localization-language-wrapper {
            display: none;
        }

        .header.logo--middle.search--icon__mobile-only {
            grid-template-areas:'menu_drawer search-left heading icons';
            grid-template-columns: max-content;
        }
        {% if section.settings.menu_2 == blank %}
        .header.logo--left {
            grid-template-areas:'menu_drawer heading icons';
        }{% else %}
        .header.logo--left {
            grid-template-areas:'menu_drawer heading icons'
                                'navigation navigation navigation' !important;
        }

        .header.logo--middle.search--icon.search-icon__position-left {
            grid-template-areas:'search-left menu_drawer heading icons'
                                'navigation navigation navigation navigation';
        }

        .header.logo--middle.search-icon__position-right {
            grid-template-areas:'menu_drawer language_left heading icons'
                                'navigation navigation navigation navigation';
        }

        .header.logo--middle.search--expanded.search-icon__position-left {
            grid-template-areas:'menu_drawer search-left heading icons'
                                'navigation navigation navigation navigation';
            gap: 0 .5rem;
        }
        .header.logo--middle.search--icon__mobile-only {
            grid-template-areas:'menu_drawer search-left heading icons'
                                'navigation navigation navigation navigation';
        }{% endif %}

        .logo--middle .header__icons .localization-language-wrapper {
            display: flex;
            align-items: center;
        }

        .header-menu__overlay-element.shown {
            z-index: 40;
        }

        .header__search {
            width: clamp(16rem, 100vw, 30rem);
        }

        .header.logo--left.search--icon predictive-search form.search--icon .predictive-search {
            width: calc(100% + 12rem);
        }

        predictive-search form.search--expanded .predictive-search {
            min-width: calc(550px - 2px);
            transform-origin: calc(50% + 2rem) -1.5rem;
        }{% else %}

        header-drawer {
            display: none;
        }

        {% case settings.logo_position %}
            {% when 'left' %}
            {% if settings.show_search_icon == 'all_screens' %}
        .header.logo--left.search--icon {
            grid-template-areas:
                'heading icons icons'{% if section.settings.show_header_line_divider %}
                'line_divider line_divider line_divider'{% endif %}
                'navigation navigation navigation';
        }
        {% elsif settings.show_search_icon == 'none' %}
        .header.logo--left.search--expanded {
            grid-template-areas:
                'heading icons icons'{% if section.settings.show_header_line_divider %}
                'line_divider line_divider line_divider'{% endif %}
                'navigation navigation navigation';
        }
        {% elsif settings.show_search_icon == 'mobile_only' %}
        .header.logo--left.search--icon__mobile-only {
            grid-template-areas:
                'heading icons icons'{% if section.settings.show_header_line_divider %}
                'line_divider line_divider line_divider'{% endif %}
                'navigation navigation navigation';
        }{% endif %}

            {% when 'middle' %}
            {% if settings.show_search_icon == 'none' %}
            .header.logo--middle.search--expanded.search-icon__position-left {
                grid-template-areas:
                        'search-left heading icons'{% if section.settings.show_header_line_divider %}
                        'line_divider line_divider line_divider'{% endif %}
                        'navigation navigation navigation';
                grid-template-columns: repeat(3, 1fr);
            }

            .header.logo--middle.search--expanded.search-icon__position-right {
                grid-template-areas:'language_left heading icons'
                                    'navigation navigation navigation';
                grid-template-columns: auto 0fr;
            }
            {% elsif settings.show_search_icon == 'all_screens' %}
            .header.logo--middle.search--icon.search-icon__position-left {
                grid-template-areas:
                        'search-left heading icons'{% if section.settings.show_header_line_divider %}
                        'line_divider line_divider line_divider'{% endif %}
                        'navigation navigation navigation';
                grid-template-columns: repeat(3, 1fr);
            }

            .header.logo--middle.search--icon.search-icon__position-right {
                grid-template-areas:'language_left heading icons'
                                    'navigation navigation navigation';
                grid-template-columns: auto 0fr;
            }
            {% elsif settings.show_search_icon == 'mobile_only' %}
            .header.logo--middle.search--icon__mobile-only.search-icon__position-left {
                grid-template-areas:
                        'search-left heading icons'{% if section.settings.show_header_line_divider %}
                        'line_divider line_divider line_divider'{% endif %}
                        'navigation navigation navigation';
                grid-template-columns: repeat(3, 1fr);
            }

            .header.logo--middle.search--icon__mobile-only.search-icon__position-right {
                grid-template-areas:'language_left heading icons'
                                    'navigation navigation navigation';
                grid-template-columns: auto 0fr;
            }
            {% endif %}
            .header__heading-link .h3 {
                word-break: normal;
            }
        {% endcase %}

        .switcher-language__left {
            grid-area: language_left;
        }{% endif %}

        .header__buttons--wrapper {
            position: relative;
        }

        .header__heading-link {
            margin-left: -.75rem;
            margin-bottom: 0;
        }

        .header__icons._expanded {
            gap: 1.5rem; {% if request.locale.iso_code contains 'ar' %}
            margin-right: 1rem;{% else %}
            margin-left: 1rem;{% endif %}
        }

        .header__icons[data-only-icons="true"] localization-form button .language-icon__wrapper ~ span,
        .header__icons[data-only-icons="true"] .account-label,
        .header__icons[data-only-icons="true"] .cart-label {
            display: none;
        }{% if localization.available_languages.size > 1  or localization.available_countries.size > 1 %}
        .header__icons .localization-currency-wrapper,
        .header__icons .localization-language-wrapper {
            display: block;
        }

        .header__icons .localization-language-wrapper button .language-icon__wrapper ~ span,
        .header__icons .localization-selector .localization-form__currency-name,
        .header__icons .localization-selector .localization-form__country,
        .header__icons .localization-selector .localization-form__currency::before,
        .header__icons .localization-selector .localization-form__currency::after {
            display: none;
        }

        .header__icons .localization-selector {
            gap: .25rem;
            width: auto;
        }

        .header__icons button.localization-selector {
            padding-right: .25rem;
        }{% endif %}

        .list-menu--inline :is(svg.menu-item__phone) {
          position: absolute;
          width: calc(1rem + 6px);
        }

        .list-menu--inline :is(svg.menu-item__phone) + span {
          margin-left: 1.75rem;
        }
    }

    @media (min-width: 1200px), print {
        .header__icons .localization-language-wrapper button .language-icon__wrapper ~ span {
            display: block;
        }
    }
    {% if section.settings.type_menu == 'slideout' or section.settings.type_menu == 'combined' %}
    @media (min-width: 1300px), print {
        .header.logo--left .header__icons button:not(.search__button),
        .header.logo--left .header__icons .button {
            min-width: 8rem;
        }

        .header.logo--left .header__icons button.localization-selector {
            padding-right: .75rem;
        }

        .header.logo--left .header__icons._icon__mobile-only {
            gap: 1.5rem;
        }
    }{% endif %}
{% endstyle %}
{% style %}
    .list-menu {
        list-style-type: none;
        margin: 0;
    }

    .list-menu--inline > li {
        display: flex;
        align-items: center;
    }

    .list-menu--inline > li:not(.top__menu-item-active):last-child {
        margin: 0;
    }

    .list-menu__item {
        display: flex;
        align-items: center;
        line-height: 1.3;

    }{% if section.settings.enable_menu_items_uppercase %}

    .menu-drawer__top-level-menu > li > details > summary,
    .menu-drawer__top-level-menu > li > a:not(.business-announcement) {
        text-transform: uppercase;
    }{% endif %}

    [data-main-item-menu=true] .header__submenu .list-menu__item,
    .dropdown-inner.small .list-menu__item {
        position: relative;
        width: 100%;
        word-break: break-word;
    }

    [data-main-item-menu=true] .header__submenu .list-menu__item .icon {
        position: absolute;
        right: 0.5rem;
        transform: rotate(0deg);
        transition: transform 0.2s ease-in-out;
    }

    @media (min-width: 768px), print {
        .header .highlite_parent_item_on_active_child,
        .top__menu-item-active {
            margin-left: -1px;
        }{% if settings.current_presets == 'default' %}

        .header .highlite_parent_item_on_active_child,
        .header [data-items-menu].top__menu-item-active summary svg,
        .header [data-main-item-menu].top__menu-item-active .header__menu-item-top svg,
        .header [data-main-item-menu].top__menu-item-active .header__menu-item-top span,
        .header [data-items-menu].top__menu-item-active .header__menu-item-top span {
            color: var(--color-base-accent-1-inverse);
        }{% endif %}

        .header .highlite_parent_item_on_active_child::after,
        li[data-link-highlighted="true"]::after,
        .header .list-menu--inline > li:last-child::after,
        .top__menu-item-active::after {
            display: none;
        }

        .list-menu--inline {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }{% if request.locale.iso_code contains 'ar' %}

        summary.header__menu-item > svg {
            margin-left: .5rem;
        }{% else %}

        summary.header__menu-item > svg {
            margin-right: .5rem;
        }{% endif %}

        .header__menu-item-top {
            font-size: {% if settings.current_presets == 'default' or settings.current_presets == 'metalware' %}1.125{% else %}1{% endif %}rem;
            padding: {% if settings.current_presets == 'gorpcore' %}.5rem 1.5rem{% else %}.75rem 1.5rem{% endif %};
        }
        {% unless settings.current_presets == 'metalware' %}
        .header__menu-item-top {
            font-weight: bold;
        }{% endunless %}

        .header .header__menu-item-top .icon-caret {
            margin-right: 0.25rem;
            margin-left: 0.25rem;
        }

        .dropdown-inner:not(.small) summary {
            padding-left: 0;
        }
    }
    {% if section.settings.dislay_shopname_on_mobile %}
    @media (max-width: 900px), print {
        .header__heading [data-media="desktop__only"],
        .header__heading .header__heading-logo {
            display: none;
        }

    }{% endif %}

    @media (min-width: 990px), print {
        .list-menu--inline > li:has(.phone-icon) {
            color: var(--header--item-highlighted-foreground);
            background: var(--header--item-highlighted-background);
            border-radius: 5px;
        }
        {% if section.settings.add_menu_dividers %}
        .header .list-menu--inline > li::after {
            content: '';
            height: 2rem;
            width: 1px;
            background-color: rgba(var(--header--text-color-rgb), .3);
        }{% endif %}

        [data-theme-preset="gorpcore"] .list-menu--inline,
        [data-theme-preset="metalware"] .list-menu--inline {
            margin: .75rem 0;
        }

        .list-menu--inline > li > a:has(.phone-icon) {
            position: relative;
            padding: 0.4rem 1rem;
        }

        .list-menu--inline :is(.phone-icon) {
            position: absolute;
            left: .75rem;
        }

        .dropdown-inner {
            background-color: var(--header--dropdown-background, #fafafa);
            --color-foreground: var(--header--dropdown-color);
            --color-foreground-75: rgba(var(--header--dropdown-color-rgb), .75);
        }{% if settings.current_presets == 'gorpcore' %}

        .header .highlite_parent_item_on_active_child,
        .top__menu-item-active,
        .header .header__menu-item-1-highlighted {
            border-radius: 1.5rem;
        }{% endif %}
        {% if settings.current_presets == 'default' %}
        .top__menu-item-active,
        .header .highlite_parent_item_on_active_child,
        .header .header__menu-item-1-highlighted {
            border-top-left-radius: 0.25rem;
            border-top-right-radius: 0.25rem;
        }{% endif %}{% if section.settings.enable_menu_items_uppercase %}

        .header__menu-item-top,
        .header__menu-item-top :is(.list-menu__item) {
            text-transform: uppercase;
        }{% endif %}

        .header__menu-item-top :is(.list-menu__item) {
            position: relative;
        }

        .header .highlite_parent_item_on_active_child,
        .top__menu-item-active,
        .header .header__menu-item-1-highlighted {
            color: var(--header--item-highlighted-foreground);
            background: var(--header--item-highlighted-background);
        }

        [data-main-item-menu] .childlist-menu--disclosure,
        .dropdown-inner.small .childlist-menu--disclosure {
            background: var(--header--dropdown-third--level-background);
            color: var(--header--dropdown-third--level-color);
        }

        .header__inline-menu {
            display: block;
            margin: 1.5rem 0 0;
        }

        [data-main-item-menu] .childlist-menu--disclosure {
            display: {% if section.settings.show_collection_image %}flex{% else %}block{% endif %};
        }
        {% if section.settings.dislay_shopname_on_mobile %}
        .header__heading [data-media="mobile__only"] {
            display: none;
        }{% endif %}
    }
{% endstyle %}

{%- if request.locale.iso_code contains 'ar' -%}
    {% style %}
        .header.search--icon .search__input {
            left: 0;
        }

        @media all and (max-width: 480px), print {
        	.logo--middle.search--icon .header__search .search__button {
                padding-right: 0;
            }
        }

        @media all and (min-width: 500px), print {
        	.logo--middle.search--icon .predictive-search {
                left: calc(100% + 10rem);
            }
        }

        @media all and (min-width: 990px), print {
            .logo--middle predictive-search .predictive-search {
                right: 0;
            }{% unless section.settings.type_menu == 'navigation' %}

            .logo--middle.search--icon .header__search .search__button,
            .logo--middle .search--icon .search__input {
                left: 0;
                right: unset;
            }{% endunless %}

            .header.search--icon {
                grid-template-columns: 1fr 1fr .5fr auto;
            }
        }
    {% endstyle %}
{%- endif -%}

{%- unless searchLayout == 'expanded' -%}
    {% style %}
        .header.search--icon .header__search .search__button {
            background: transparent;
            color: var(--header--text-color);
        }

        @media all and (max-width: 989px) {
            .header.search--icon__mobile-only {
                grid-template-areas: 'menu_drawer heading search-left icons';
            }

            .header.search--icon__mobile-only .header__search .search__button {
                background: transparent;
                color: var(--header--text-color);
            }

            .header.search--icon__mobile-only .header__heading-link,
            .header.search--icon .header__heading-link {
                margin-bottom: 0.25rem; {% if section.settings.dislay_shopname_on_mobile %}
                margin-right: 2rem;{% endif %}
            }

            .header.search--icon__mobile-only .header__search .search__button,
            .header.search--icon .header__search .search__button {
                padding: 1.25rem 0.5rem;
            }

            .header.search--icon__mobile-only .header__search .search__button:not(.disclosure__button),
            .header.search--icon .header__search .search__button:not(.disclosure__button) {
                top: 50%;
                transform: translateY(-50%);
            }
        }

        @media all and (min-width: 990px) {
            .search--icon .search__button {
                top: 50%;
                transform: translateY(-50%);
            }
            {% unless request.locale.iso_code contains 'ar' %}{% unless section.settings.type_menu == 'navigation' %}
            .logo--middle.search-icon__position-left .search--icon .field__button,
            .logo--middle.search-icon__position-left .search__input {
                right: unset;
            }{% endunless %}{% endunless %}

            .logo--middle .search--icon .search_label {
                display: block;
            }
            {% unless section.settings.type_menu == 'navigation' %}
            .logo--middle.search-icon__position-left .search--icon.active .search__input {
                padding-left: 2.5rem;
            }

            .logo--middle.search-icon__position-left .predictive-search {
                left: 0;
            }

            .logo--middle .search--icon .search__input {
                left: unset;
            }{% if section.settings.menu_2 == blank %}

            header.header {
                padding-bottom: 0.25rem;
            }{% endif %}
            {% endunless %}
            predictive-search form.search--icon .predictive-search {
                left: unset
            }
        }
    {% endstyle %}
{%- endunless -%}

{%- if settings.predictive_search_use_filter_by_category %}
    {% style %}
        :is(filter-category) {
            position: absolute;
            right: 3rem;
            top: 2px;
            z-index: 99;
        }

        .search-filter-wrapper > button {
            border-color: transparent;
            border-radius: 0;
            border-left: 1px solid var(--color-button-border);
            box-shadow: none;
            padding: .35rem .75rem .5rem;
        }

        .search-filter-wrapper button > svg {
            color: var(--search--input--text-color) !important;
        }

        .search-filter-wrapper > button > span {
            font-weight: 400;
        }

        .search-filter-wrapper > button > span,
        .search-filter-wrapper .results-option span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        header .search-filter-wrapper svg {
            width: 1rem;
            height: 1rem;
        }

        @media all and (max-width: 500px) {
            .search-filter-wrapper > button > span {
                max-width: 2.5rem;
            }

            .search-filter-wrapper .current-option__desktop {
                display: none;
            }
        }

        @media all and (min-width: 501px) and (max-width: 989px) {
            .search-filter-wrapper > button > span {
                max-width: 5rem;
            }

            .search-filter-wrapper .current-option__mobile {
                display: none;
            }
        }

        @media all and (min-width: 990px) {
            .search-filter-wrapper .current-option__mobile {
                display: none;
            }

            .search-filter-wrapper > button > span {
                max-width: 10rem;
            }

            .logo--middle.search--icon.search-icon__position-left :is(filter-category) {
                right: 0;
            }
        }
    {% endstyle %}
{% endif -%}

