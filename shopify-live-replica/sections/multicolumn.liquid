{%- liquid
    assign sectionId = section.id | prepend: '#shopify-section-'
    assign columnsCount = 4
    if section.blocks.size < 4
        assign columnsCount = section.blocks.size
    endif

    assign ratio = 1
    case section.settings.image_ratio
        when 'adapt'
            assign ratio = 0
            for block in section.blocks
                if block.settings.image and block.settings.image.aspect_ratio > ratio
                    assign ratio = block.settings.image.aspect_ratio
                endif
            endfor
            if ratio == 0
                assign ratio = 1
            endif

        when 'portrait'
            assign ratio = 4 | divided_by: 5.0
    endcase

    assign useViewAllButton = false
    if section.settings.view_all_appearance == 'button' or section.settings.view_all_appearance == 'button_secondary'
        assign useViewAllButton = true
    endif

    assign image_position = section.blocks | where: 'type', 'column' | first
    assign image_position = image_position.settings.image_position

    assign imageWidthDivider = 1

    case section.settings.image_width
        when 'w-1/3'
            assign imageWidthDivider = 3
        when 'w-1/2'
            assign imageWidthDivider = 2
    endcase

    case columnsCount
        when 1
            assign image_sizes = '(max-width: 480px) 100vw, (max-width: 767px) calc((100vw - 2rem) / #divider#), (max-width: 1279px) calc((100vw - 6rem) / #divider#), calc(1184px / #divider#)'
        when 2, 3
            assign image_sizes = '(max-width: 480px) 100vw, (max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw'
        else
            assign image_sizes = '(max-width: 480px) 100vw, (max-width: 639px) calc((100vw - 2rem) / #divider#), (max-width: 767px) calc((100vw - 7rem) / 2 / #divider#), (max-width: 989px) calc((100vw - 8rem) / 3 / #divider#), (max-width: 1279px) calc((100vw - 9rem) / 4 / #divider#), calc((1184px - 3rem) / 4 / #divider#)'
    endcase

    assign image_sizes = image_sizes | replace: '#divider#', imageWidthDivider

    assign mainClass = 'multicolumn'
    if section.settings.title == blank
        assign mainClass = mainClass | append: ' no-heading'
    endif

    if section.settings.animation_on_reveal
        assign mainClass = mainClass | append: ' reveal-slide-in'
    endif
-%}

{% style %}
    {% unless section.settings.button_label == blank %}
    .multicolumn .heading {
        display: flex;
        align-items: center;
    }

    .multicolumn .heading:not(.title-wrapper-with-link--no-heading) {
        justify-content: space-between;
    }

    .multicolumn :is(.title-wrapper-with-link--no-heading) {
        margin-top: 1.5rem;
        margin-bottom: -1rem;
        justify-content: end;
    }{% endunless %}

    .multicolumn-list {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .multicolumn-list:is(.with--no-title) {
        margin: 2.5rem 0 0;
    }

    .multicolumn-list__item {
        width: 100%;
    }{% if settings.use_elements_border_radius %}

    .multicolumn-card__image-cover,
    .multicolumn-list__item,
    .multicolumn-list__item .media,
    .multicolumn-card__image-cover .media :is(img, svg) {
        border-radius: {{ settings.blocks_border_radius_value }}rem;
        -webkit-border-radius: {{ settings.blocks_border_radius_value }}rem;
    }{% case section.settings.column_direction %}
        {% when 'row' %}
        .multicolumn-card__image-contain :is(.media > *) {
            border-top-left-radius: {{ settings.blocks_border_radius_value }}rem;
            border-bottom-left-radius: {{ settings.blocks_border_radius_value }}rem;
        }

        {% when 'row-reverse' %}
        .multicolumn-card__image-contain :is(.media > *) {
            border-top-right-radius: {{ settings.blocks_border_radius_value }}rem;
            border-bottom-right-radius: {{ settings.blocks_border_radius_value }}rem;
        }
        {% when 'column' %}
            {% if section.settings.image_width == 'w-full' %}
            .multicolumn-card__image-contain :is(.media > *) {
                border-top-right-radius: {{ settings.blocks_border_radius_value }}rem;
                border-top-left-radius: {{ settings.blocks_border_radius_value }}rem;
            }{% endif %}
        {% when 'column-reverse' %}
            {% if section.settings.image_width == 'w-full' %}
            .multicolumn-card__image-contain :is(.media > *) {
                border-bottom-right-radius: {{ settings.blocks_border_radius_value }}rem;
                border-bottom-left-radius: {{ settings.blocks_border_radius_value }}rem;
            }{% endif %}
    {% endcase %}{% endif %}
    {% if section.settings.image_ratio == 'circle' %}

    .multicolumn :is(.media > *) {
        border-radius: 100%;
    }{% endif %}

    .multicolumn-card:is(.with--outline) {
        box-shadow: 0 0 1px 1px var(--color-foreground-20);
    }

    .multicolumn-card.image--spaced .multicolumn-card__image-wrapper {
        padding: 1rem;
    }

    .multicolumn-card .multicolumn-card__image-wrapper {
        position: relative;
    }

    .multicolumn-card__image-wrapper :is(.loading-overlay) {
        z-index: 1;
    }

    .multicolumn-card__content {
        flex-grow: 1;
        margin: 0.75rem 1.5rem;
        word-break: break-word;
    }

    .multicolumn-card__content h3 {
        margin: 0 0 .5rem;
    }

    .multicolumn-card__content .sub_title {
        font-size: .75rem;
        line-height: 3;
        padding: .25rem .5rem;
        text-transform: uppercase;
        font-weight: 600;{% if settings.current_presets == 'gorpcore' or settings.current_presets == "garage" %}
        border-radius: 4px;{% endif %}
        {% if image_position == "cover" %}
        width: max-content;
        text-align:center;{% endif %}{% if settings.current_presets == 'garage'%}
        line-height: unset;{% endif %}
    }

    {{ sectionId }} .multicolumn-card__image-contain .button,
    {{ sectionId }} .multicolumn-card__image-cover .button {
        width: fit-content;
        height: fit-content;{% if settings.current_presets == 'default' %}
        font-weight: 500;{% endif %}
    }

    .multicolumn-card__image-contain .button {
        margin: 1.5rem 0;
    }

    @media (min-width: 480px), print {
        .multicolumn-card__content {
            font-size: 1.125rem;
        }

        .multicolumn-card__content h3 {
            font-size: 1.5rem;
            line-height: 1.35;
        }
    }
    {% if section.settings.swipe_on_mobile %}
    @media (max-width: 767px), print {
        .slider-mobile-gutter .slider {
            padding-bottom: 0;
        }
    }{% endif %}

    {{ sectionId }} .multicolumn-card__image-contain,
    {{ sectionId }} .multicolumn-card__image-cover {
        display: flex;
        position: relative;
        overflow: hidden;
    }

    {{ sectionId }} .multicolumn-card__content:is(._cover) {
        display: flex;
        justify-content: space-between;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        padding-left: 1rem;
        padding-right: 1rem;
    }

    {{ sectionId }} .multicolumn-card__content:is(.content-direction-column) {
        flex-direction: column;
        height: calc(100% - 4rem);
    }

    {{ sectionId }} .multicolumn-card__content:is(.content-direction-row) {
        align-items: end;
        gap: 1rem;
    }

    {{ sectionId }} .multicolumn-card__content:is(.content-direction-row) > * {
        margin: 0;
    }

    {{ sectionId }} .multicolumn-card__content:is(.content-direction-row) > :is(.button) {
        margin-bottom: calc(1.5rem - 2px);
    }

    {{ sectionId }} .multicolumn-card__content._cover:is(.content-direction-column) .button {
        padding: 11px 46px;
        margin-top: 1rem;
    }{% if section.settings.column_direction == 'column-reverse-mobile' %}

    {{ sectionId }} .multicolumn-card__image-contain {
        flex-direction: column-reverse;
        align-items: center;{% if section.settings.column_alignment == 'center' %}
        text-align: center;{% endif %}
    }
    @media (min-width: 768px), print {
        {{ sectionId }} .multicolumn-card__image-contain {
            flex-direction: row-reverse;
        }
    }{% endif %}{% if section.settings.swipe_on_mobile %}

    @media (min-width: 640px), print {
        {{ sectionId }} .multicolumn-list__item {
            width: calc( (100% - 1rem ) / 2);
        }
    }{% if columnsCount > 2 %}

    @media (min-width: 990px), print {
        {{ sectionId }} .multicolumn-list__item {
            width: calc( (100% - 2rem ) / 3);
        }
    }{% endif %}
    {% endif %} {% unless section.settings.swipe_on_mobile %}
    {% if columnsCount > 1 %}
    @media (min-width: 640px), print {
        {{ sectionId }} .multicolumn-list__item {
            width: calc( (100% - 1rem ) / 2);
        }
    }{% endif %}{% if columnsCount > 2 %}

    @media (min-width: 768px), print {
        {{ sectionId }} .multicolumn-list__item {
            width: calc( (100% - 2rem ) / 3);
        }
    }{% endif %}{% endunless %}{% unless section.settings.column_direction == 'column-reverse-mobile' %}

    {{ sectionId }} .multicolumn-card__image-contain {
        flex-direction: {{ section.settings.column_direction }};
        align-items: center;{% if section.settings.column_alignment == 'center' %}
        text-align: center;{% endif %}
    }{% endunless %}{% if section.settings.column_direction contains 'row' %}

    {{ sectionId }} .multicolumn-card__content._contain {
        align-self: center;
    }{% endif %}

    {{ sectionId }} .multicolumn-card__image-wrapper.image--contain {
        width: {% case section.settings.image_width %}{% when 'w-full' %}100%{% when 'w-1/2' %}50%{% when 'w-1/3' %}33.33%{% endcase %};{% unless section.settings.image_width == 'w-full' %}
        flex-shrink: 0;{% endunless %}
    }

    {{ sectionId }} .multicolumn-card__image-wrapper.image--cover {
        width: 100%;
    }{% if section.settings.swipe_on_mobile %}

    @media (min-width: 640px), print {
        {{ sectionId }} .slider {
            padding: 0;
        }
        {% unless section.settings.swipe_on_mobile %}
        {{ sectionId }} .slider-buttons {
            display: none;
        }{% endunless %}
    }{% endif %}{% if section.settings.button_label != blank -%}

    {{ sectionId }} .multicolumn-buttons {
        display: none;
        text-align: center;
        margin-top: 2rem;
    }
    @media (min-width: 640px), print {
        {{ sectionId }} .multicolumn-buttons {
            display: block;
        }
    }
    {%- endif %}
    @media (min-width: 768px), print {
        .text-animation .multicolumn-card__content .title,
        .text-animation .multicolumn-card__content .text > p {
            opacity: 0;
        }
    }
    @media (min-width: 1024px), print {
        .multicolumn-card__content .sub_title {
            font-size: .875rem;
            padding: .25rem .75rem;
        }
    }
{% endstyle %}

<div class="{{ mainClass }}">
    <div class="dynamic-page-width">
        {% unless section.settings.title == blank and section.settings.button_label == blank %}
            <div class="heading{% if section.settings.title == blank %} title-wrapper-with-link--no-heading{% endif %}{% if settings.show_uppercase_heading %} uppercase{% endif %}">
                {% unless section.settings.title == blank -%}
                    <{{ section.settings.title_size }} class="section--title reveal-item{% if settings.show_uppercase_heading %} uppercase{% endif %}">
                        {% render 'helper__decorate-heading', heading: section.settings.title %}
                    </{{ section.settings.title_size }}>
                {%- endunless %}
                {%- liquid
                    assign button_class = 'view-all'
                    case section.settings.view_all_appearance
                        when 'button'
                            assign button_class = button_class | append: ' button button--primary animate-arrow'
                        when 'button_secondary'
                            assign button_class = button_class | append: ' button animate-arrow'
                        when 'link'
                            assign button_class = button_class | append: ' link'
                    endcase

                    if settings.show_button_ring_on_hover
                        assign button_class = button_class | append: ' border--outline'
                    endif
                    if settings.cut_button_corners
                        assign button_class = button_class | append: ' border--with-cut-corners'
                    endif

                    if section.settings.animation_on_reveal
                        assign button_class = button_class | append: ' reveal-item'
                    endif
                -%}
                {% unless section.settings.button_label == blank %}
                    <a
                        href="{{ section.settings.button_link }}"
                        class="{{ button_class }}"
                        aria-label="{{ 'sections.collection_list.view_all' | t }}"
                        title="{{ 'sections.collection_list.view_all' | t }}"
                    >
                        {{ section.settings.button_label | escape }}
                        {% if useViewAllButton and settings.show_icon_arrow -%}
                            {% render 'icons-solid', name: 'arrow-right', css_class: 'icon-arrow' %}
                        {% endif %}
                    </a>
                {%- endunless %}
            </div>
        {% endunless %}

        {% capture listHtml %}
      <ul class="multicolumn-list {% if section.settings.swipe_on_mobile and section.blocks.size > 1 %}slider slider--tablet grid--peek{% endif %}{% if section.settings.title == blank %} with--no-title{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li class="multicolumn-list__item n{{ columnsCount }} grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %} reveal-item cut-border-corner__{{ block.settings.cut_border_corner }}"
            {% if block.settings.add_cover %} style="background: {{ block.settings.cover_background_gradient | default: block.settings.cover_background }}"{% endif %}
            {{ block.shopify_attributes }}
          >

            {%- capture innerHtml %}
              {%- render 'multicolumn-content' 
                block: block
                foloop_index: forloop.index
                section: section
                image_ratio: ratio
                image_width_divider: imageWidthDivider
                image_sizes: image_sizes 
              -%}
            {% endcapture -%}

            {%- liquid
              assign _class_ = 'multicolumn-card'
              assign _class_ = _class_ | append: ' multicolumn-card__image-'
              assign _class_ = _class_ | append: block.settings.image_position
              if section.settings.show_outline
                assign _class_ = _class_ | append: ' ' | append: 'with--outline'
              endif

              if block.settings.image_spaced
                assign _class_ = _class_ | append: ' ' | append: 'image--spaced'
              endif
            -%}
            {%- if block.settings.link and block.settings.link_appearance == 'image_link' -%}
              <a class="{{ _class_ }}" href="{{ block.settings.link }}" title="{{ block.settings.link.title }}">
                {{ innerHtml }}
              </a>
            {%- else -%}
              <div class="{{ _class_ }}">
                {{ innerHtml }}
              </div>
            {%- endif -%}

          </li>
        {%- endfor -%}
      </ul>
    {% endcapture -%}

        {%- if section.settings.swipe_on_mobile -%}
            <slider-component class="slider-mobile-gutter" data-loop="false">
                {{ listHtml }}
                <div class="slider-buttons__container">
                    <div class="slider-buttons no-js-hidden">
                        <!--
                            <div class="slider-counter caption">
                                <span class="slider-counter--current">1</span>
                                <span aria-hidden="true"> / </span>
                                <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
                                <span class="slider-counter--total">{{ section.blocks.size }}</span>
                            </div>
                        -->
                        <button
                            type="button"
                            class="slider-button slider-button--prev"
                            name="previous"
                            aria-label="{{ 'accessibility.previous_slide' | t }}"
                        >
                            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret">
                                <use href="#icon-caret" />
                            </svg>
                        </button>
                        <button
                            type="button"
                            class="slider-button slider-button--next"
                            name="next"
                            aria-label="{{ 'accessibility.next_slide' | t }}"
                        >
                            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret">
                                <use href="#icon-caret" />
                            </svg>
                        </button>
                    </div>
                </div>
            </slider-component>
        {% else %}
            {{ listHtml }}
        {%- endif -%}
    </div>
</div>

{{ 'section-multicolumns.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'section-multicolumns.css' | asset_url | stylesheet_tag }}</noscript>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "spaced-section spaced-section--full-width",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Multicolumn",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "title_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.multicolumn.settings.title_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.multicolumn.settings.title_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.multicolumn.settings.title_size.options.h3"
        }
      ],
      "default": "h2",
      "label": "t:sections.multicolumn.settings.title_size.label"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "w-1/3",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "w-1/2",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "w-full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "w-1/2",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "column_direction",
      "options": [
        {
          "value": "row",
          "label": "t:sections.multicolumn.settings.column_direction.options__1.label"
        },
        {
          "value": "row-reverse",
          "label": "t:sections.multicolumn.settings.column_direction.options__2.label"
        },
        {
          "value": "column",
          "label": "t:sections.multicolumn.settings.column_direction.options__3.label"
        },
        {
          "value": "column-reverse",
          "label": "t:sections.multicolumn.settings.column_direction.options__4.label"
        },
        {
          "value": "column-reverse-mobile",
          "label": "t:sections.multicolumn.settings.column_direction.options__5.label"
        }
      ],
      "default": "row",
      "label": "t:sections.multicolumn.settings.column_direction.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "view_all_appearance",
      "options": [
        {
          "value": "button",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.button"
        },
        {
          "value": "button_secondary",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.button_secondary"
        },
        {
          "value": "link",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.link"
        }
      ],
      "default": "button",
      "label": "t:sections.featured-collection.settings.view_all_appearance.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "animation_on_reveal",
      "label": "t:sections.all.settings.animation_on_reveal.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_outline",
      "label": "t:sections.multicolumn.settings.show_outline.label",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size_heading",
      "min": 1.5,
      "max": 3.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.5,
      "label": "t:sections.multicolumn.settings.font_size_heading.label"
    },
    {
      "type": "checkbox",
      "id": "use_bold_heading",
      "default": false,
      "label": "t:sections.multicolumn.settings.use_bold_heading.label"
    },
    {
      "type": "checkbox",
      "id": "use_uppercase_heading",
      "default": false,
      "label": "t:sections.multicolumn.settings.use_uppercase_heading.label"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "default":"Banner Title",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "inline_richtext",
          "id": "sub_title",
          "default": "Up to 50% off",
          "label": "t:sections.multicolumn.blocks.column.settings.sub_title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Describe a product, make announcements.</p>",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
        },
        {
          "type": "select",
          "id": "link_appearance",
          "options": [
            {
              "value": "button",
              "label": "t:sections.multicolumn.blocks.column.settings.link_appearance.options.button"
            },
            {
              "value": "button_secondary",
              "label": "t:sections.multicolumn.blocks.column.settings.link_appearance.options.button_secondary"
            },
            {
              "value": "image_link",
              "label": "t:sections.multicolumn.blocks.column.settings.link_appearance.options.image_link"
            }
          ],
          "default": "image_link",
          "label": "t:sections.multicolumn.blocks.column.settings.link_appearance.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.multicolumn.blocks.column.settings.button_label.label",
          "info": "t:sections.multicolumn.blocks.column.settings.button_label.info",
