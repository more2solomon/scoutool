{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% style %}
    @media only screen and (max-width: 600px) {
        slider-vertical button { opacity: 0; }
    }{% if template contains 'sticky-info' %}
    .template__sticky-info .product__info-gallery-side .product__info-block--description {
        display: none;
    }
    @media (min-width: 990px), print {
        .template__sticky-info .product__info-gallery-side .product__info-block--description {
            display: -webkit-box;
        }
        .template__sticky-info .product__info-block--description:not(._aside) {
            margin-top: 4rem;
        }
        .template__sticky-info .product__info-aside .product__info-block--description {
            display: none;
        }
    }{% else %}
    .template__product .product__info-block--description._aside {
        display: none;
    }
    .template__product .product__info-aside .product__info-block--description._aside {
        display: -webkit-box;
    }{% endif %}

    .product__title--sku {
        display: inline-block;
        float: right;
        padding: .15rem 0rem 0 0;
    }

    .product__title + .product__title--sku {
        float: unset;
    }

    variant-radios :has(slider-component) .swatch-options__slider {
        position: absolute;
    }

    @media only screen and (min-width: 1200px) {
        .product__title--sku {
            padding: .15rem 3rem 0 0;
        }
    }

    @media only screen and (min-width: 640px) {
        slider-vertical > button > svg {
            height: 1rem;
            width: 1rem;
        }

        slider-vertical > [type="button"] {
            min-width: auto;
            border: 0;
            border-radius: 3px;
            bottom: 4px;
            display: flex !important;
            opacity: .75;
            padding: .25rem;
            height: fit-content;
        }

        slider-vertical:not([data-thumbs-mode="grid_below"]) > [type="button"] {
            position: absolute;
            z-index: 10;
            left: 1rem;
            right: 1rem;
        }
        {%- if settings.current_presets  == 'default' %}
        .product__info-block--title {
            flex-direction: row;
        }{% else %}

        .product__info-block--title {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
        }{% endif -%}
    }
    /* color swatches size */
    .product__info-block .swatch-option[type=radio] + label {
        padding: 1rem;
    }

    .product__info-block .swatch-option[type=radio]:checked + label:before,
    .product__info-block .swatch-option[type=radio] + label:hover:before {
        padding: 1.125rem;
    }
{% endstyle %}

{%- liquid
    assign class = 'dynamic-page-width'

    if template contains 'sticky-info'
        assign class = class | append: ' template__sticky-info'
    else
        assign class = class | append: ' template__product'
    endif

    if section.settings.animation_on_reveal
        assign class = class | append: ' reveal-slide-in'
    endif

    assign share_block = section.blocks | where: 'type', 'share' | first
    assign complementary_block = section.blocks | where: 'type', 'products_complementary' | first
-%}
<div class="{{ class }}">
    <div id="has-options" class="message-wrapper" role="alert" hidden>
        <div class="form__message--notice form__message">
            {% render 'icons-outline', name: 'exclamation-circle' %}
            <p class="notice-message">{{ 'products.product.has_options_message' | t }}</p>
        </div>
    </div>
    {% liquid
        assign has_gallery = true
        assign galleries = section.blocks | where: 'type', 'gallery'
        if galleries.size < 1
            assign has_gallery = false
        endif
        if product.media.size < 1
            assign has_gallery = false
        endif

        assign has_gallery_placeholder = settings.use_gallery_placeholder
        assign product_info_class = 'product__info'
        if has_gallery or has_gallery_placeholder
            assign product_info_class = product_info_class | append: ' product__info--with-gallery'
        endif

        if section.settings.enable_sticky_info
            assign product_info_class = product_info_class | append: ' product__info--sticky'
        endif
    %}
    <div id="ProductInfo-{{ section.id }}" class="{{ product_info_class }}">
        {% if template contains 'sticky-info' %}<div class="product__info-gallery-side">{% endif %}
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'gallery' -%}
                    {% render 'product__info-block--gallery',
                        block: block,
                        blockOrder: forloop.index,
                        sectionId: section.id,
                        product: product
                    %}
                {%- when 'description' -%}
                    {% render 'product__info-block--description',
                        block: block,
                        blockOrder: forloop.index,
                        sectionId: section.id,
                        product: product
                    %}
            {%- endcase -%}
        {%- endfor -%}
        {% if template contains 'sticky-info' %}</div>{% endif %}

        <div class="product__info-aside">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when '@app' -%}
                        {% render 'product__info-block--app',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}

                    {%- when 'buy_buttons' -%}
                        {% render 'product__info-block--buy_buttons',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'collapsible_tab' -%}
                        {% render 'product__info-block--collapsible_tab',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'description' -%}
                        {% render 'product__info-block--description',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'pickup' -%}
                        {% render 'product__info-block--pickup',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'popup' -%}
                        {% render 'product__info-block--popup',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'price' -%}
                        {% render 'product__info-block--price',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'quantity_selector' -%}
                        {% render 'product__info-block--quantity_selector',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'share' -%}
                        {% render 'product__info-block--share',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'text' -%}
                        {% render 'product__info-block--text',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'title' -%}
                        {% render 'product__info-block--title',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'message' -%}
                        {% render 'product__info-block--message',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'variant_picker' -%}
                        {% render 'product__info-block--variant_picker',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'manage_stock' -%}
                        {% render 'product__info-block--manage_stock',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'products_complementary' -%}
                        {% render 'product__info-block--products_complementary',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'custom_liquid' -%}
                        {% render 'product__info-block--custom_liquid',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'icons_bar' -%}
                        {% render 'product__info-block--icons_bar',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                    {%- when 'payment_icons' -%}
                        {% render 'product__info-block--payment_icons',
                            block: block,
                            blockOrder: forloop.index,
                            sectionId: section.id,
                            product: product
                        %}
                {%- endcase -%}
            {%- endfor -%}
        </div>
    </div>

    {%- render 'product-modal', product: product, modal_id: section.id -%}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
        {% if forloop.first %}
            <link
                rel="stylesheet"
                href="{{ 'component-modal-dialog.css' | asset_url }}"
                media="print"
                onload="this.media='all'"
            >
        {% endif %}
        {%- render 'modal-dialog',
            id: block.id,
            aria_label: block.settings.link_label,
            title: block.settings.page.title,
            content: block.settings.page.content
        -%}
    {%- endfor -%}

    {% if section.settings.enable_quick_add %}
        {% render 'product__add-to-cart-sticky',
            sectionId: section.id,
            product: product,
            blocks: section.blocks,
            show_variants: section.settings.show_product_variants,
            show_img: section.settings.show_product_img
        %}
    {% endif %}
</div>

