{%- if settings.enable_recently_viewed_products %}
    <script type="text/javascript" defer>
        const _initRecentlyViewedItems = () => {
            const maxItems = {{ settings.recently_viewed_limit_to_show }}; // max 12 saved in the configuration
            const productHandle = "{{ product.handle }}";
            if (!productHandle) return;

            // get items and filter if already exist
            let viewed = JSON.parse(localStorage.getItem("argento_recently_viewed")) || [];
            viewed = viewed.filter(handle => handle !== productHandle);

            // add product to the start
            viewed.unshift(productHandle);
            if (viewed.length > maxItems) viewed.pop();
            // save items
            localStorage.setItem("argento_recently_viewed", JSON.stringify(viewed));
        }

        document.addEventListener("DOMContentLoaded", () => { _initRecentlyViewedItems(); });
    </script>
{% endif -%}

<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ shop.url | append: product.url | json }},
        "image": {{ product.featured_image | json }},
        "brand": {
            "@type": "Thing",
            "name": {{ product.vendor | json }}
        },
        "description": {{ product.description | strip_html | truncatewords: 30 | json }},
        "sku": {% if product.sku != null %}{{ product.sku | json }}{% else %}{{ product.variants[0].sku | json }}{% endif %},
        "barcode": {% if product.barcode != null %}{{ product.barcode | json }}{% else %}{{ product.variants[0].barcode | json }}{% endif %},
        "offers": {
            "@type": "AggregateOffer",
            "highPrice": {{ product.price_max | money_without_currency | json }},
            "lowPrice": {{ product.price_min | money_without_currency | json }},
            "offerCount":{% if product.selected_or_first_available_variant.inventory_quantity > 0 %}{{ product.selected_or_first_available_variant.inventory_quantity | json }}{% else %}"0"{% endif %},
            "price": {% if product.price != null %}{{ product.price | money_without_currency | json }}{% else %}{{ product.variants[0].price | money_without_currency | json }}{% endif %},
            "priceCurrency": "{{ cart.currency.iso_code }}",
            "priceSpecification": [{% for item in product.variants %}{% if item.compare_at_price > item.price %}
                {
                    "@type": "UnitPriceSpecification",
                    "priceType": "https://schema.org/MSRP",
                    "price":{{ item.compare_at_price | money_without_currency | json }},
                    "valueAddedTaxIncluded": {{ cart.taxes_included }}
                },
                {
                    "@type": "UnitPriceSpecification",
                    "priceType": "https://schema.org/SalePrice",
                    "price": {{ item.price | money_without_currency | json }}
                }{% endif%}{% endfor %}
            ],
            "offers": [{% if product.variants.size > 1%}{% for item in product.variants %}
                {
                    "@type": "Offer",
                    "sku": {{ item.sku | json }},
                    "image": {{ item.featured_image | json }},
                    "price": {{ item.price | money_without_currency | json }},
                    "priceCurrency": "{{ cart.currency.iso_code }}",
                    "availability": "http://schema.org/{% if item.available %}InStock{% else %}OutOfStock{% endif %}",
                    "itemCondition": "https://schema.org/NewCondition",
                    "url": {{ shop.url | append: item.url | json }}
                }{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}
            ]
        }
    }
</script>

