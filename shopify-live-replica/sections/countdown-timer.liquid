{%- liquid
    assign sectionId = section.id | prepend: '#shopify-section-'
    assign __class__ = 'countdown'
    if section.settings.full_width
        assign __class__ = __class__ | append: ' full--width'
    else
        assign __class__ = __class__ | append: ' dynamic-page-width'
    endif

    if section.settings.animation_on_reveal
        assign __class__ = __class__ | append: ' reveal-slide-in'
    endif

    assign image_block = section.blocks | where: 'type', 'image' | first
    unless image_block.settings.image == blank
        case image_block.settings.image_height
            when 'adapt'
                assign padding_bottom = 100 | divided_by: image_block.settings.image.aspect_ratio
                assign padding_bottom = padding_bottom | append: '%'
            when 'small'
                assign padding_bottom = '20rem'
            when 'medium'
                assign padding_bottom = '30rem'
            when 'large'
                assign padding_bottom = '40rem'
        endcase
    endunless
    unless image_block == null
        assign __class__ = __class__ | append: ' with--image'
    endunless
-%}
{% style %}
        {{ sectionId }} .countdown__media {
            padding-bottom: {% if padding_bottom == blank %}50%{% else %} {{ padding_bottom }}{% endif %};
        }
        .countdown:is(.with--image) .countdown__timer {
            max-width: calc(375px - 4px);
        }
        .countdown {
            position: relative;
        }
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when 'timer' -%}
        .countdown__timer--heading {
            margin-bottom: 1rem;
            margin-top: -1rem;
        }
        {{ sectionId }} .countdown__timer {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            text-align: center;
            padding: 2rem;
            border-radius: 4px;
        }
        {{ sectionId }} .countdown__timer.right {
            right: 1rem;
        }
        {{ sectionId }} .countdown__timer.left {
            left: 1rem;
        }
        {{ sectionId }} .countdown__timer.center {
            left: 50%;
            transform: translate(-50%, -50%);
        }
        {{ sectionId }} .countdown__timer {
            background: rgba({{ block.settings.box_background.red }},{{ block.settings.box_background.green }},{{ block.settings.box_background.blue }}, {{ block.settings.box_background_opacity }}%);
        }
        {{ sectionId }} .countdown__timer .heading,
        {{ sectionId }} .countdown__timer .subheading {
            color: {{ block.settings.heading_colors }};
        }
        {{ sectionId }} .timer-wrapper div:not(:last-child):after,
        {{ sectionId }} :is(.highlight-heading-words) {
            color: {{ block.settings.text_color }};
        }
        {{ sectionId }} .countdown__timer .heading {
            text-align: {{ block.settings.heading_position }};
        }
        @media(min-width: 750px) {
            {{ sectionId }} .countdown__timer .heading,
            {{ sectionId }} .period > span:first-child,
            {{ sectionId }} .timer-wrapper div:not(:last-child):after {
                font-size: {{ block.settings.heading_font_size }}rem;
            }
            {{ sectionId }} .countdown__timer .heading {
                padding-left: {{ block.settings.heading_font_size }}rem;
                line-height: 1;
            }
            {{ sectionId }} .countdown__timer.right {
                right: 2rem;
            }
            {{ sectionId }} .countdown__timer.left {
                left: 2rem;
            }
        }
        {%- endcase -%}
    {%- endfor -%}

        @media(min-width: 750px) {
            .countdown:is(.with--image) .countdown__timer {
                max-width: calc(580px - 4px);
            }
        }
{% endstyle %}

<div class="{{ __class__ }}">
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when 'image' -%}
                {%- liquid
                    assign media_class = 'countdown__media media'
                    if request.design_mode == false and settings.enable_preload_images
                        assign media_class = media_class | append: ' media--blur-image'
                    endif
                    if image_block.settings.image == blank
                        assign media_class = media_class | append: ' placeholder'
                    endif
                -%}
                {%- if settings.enable_preload_images -%}{%- render 'loading-overlay' -%}{%- endif -%}
                <div class="{{ media_class }}" {{ block.shopify_attributes }}>
                    {%- if image_block.settings.image != blank -%}
                        <img
                            srcset="
                                {%- if image_block.settings.image.width >= 350 -%}{{ image_block.settings.image.src | image_url: width: 401 }} 401w,{%- endif -%}
                                {%- if image_block.settings.image.width >= 500 -%}{{ image_block.settings.image.src | image_url: width: 533 }} 533w,{%- endif -%}
                                {%- if image_block.settings.image.width >= 700 -%}{{ image_block.settings.image.src | image_url: width: 744 }} 744w,{%- endif -%}
                                {%- if image_block.settings.image.width >= 1100 -%}{{ image_block.settings.image.src | image_url: width: 1176 }} 1176w,{%- endif -%}
                                {%- if image_block.settings.image.width >= 1500 -%}{{ image_block.settings.image.src | image_url: width: 1524 }} 1524w,{%- endif -%}
                                {%- if image_block.settings.image.width >= 2000 -%}{{ image_block.settings.image.src | image_url: width: image_block.settings.image.width }} {{image_block.settings.image.width | append: 'w'}}{%- endif -%}
                            "
                            src="{{ image_block.settings.image.src | image_url }}"
                            sizes="100vw"
                            alt="{{ image_block.settings.image.alt | escape }}"
                            width="{{ image_block.settings.image.width }}"
                            height="{{ image_block.settings.image.width | divided_by: image_block.settings.image.aspect_ratio }}"
                            style="object-position: {{ image_block.settings.image.presentation.focal_point }}"
                            loading="lazy"
                        >
                    {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                </div>

            {%- when 'timer' -%}
                <div class="countdown__timer {{ block.settings.timer_position }}" {{ block.shopify_attributes }}>
                    <div class="countdown__timer--heading">
                        {%- unless block.settings.heading == blank -%}
                            <h2 class="heading reveal-item rte">
                                {%- render 'helper__highlight-words',
                                    heading: block.settings.heading,
                                    words_count: block.settings.hightlight_heading_words
                                -%}
                            </h2>
                        {%- endunless -%}
                        {%- unless block.settings.text == blank -%}
                            <div class="subheading reveal-item rte">
                                {{ block.settings.text }}
                            </div>
                        {%- endunless -%}
                    </div>
                    {%- render 'countdown_timer', block: block -%}
                </div>
        {%- endcase -%}
    {%- endfor -%}
</div>

{{ 'section-countdown-timer.css' | asset_url | stylesheet_tag }}
{{ 'component-countdown-timer.css' | asset_url | stylesheet_tag }}
<noscript>
    {{ 'section-countdown-timer.css' | asset_url | stylesheet_tag }}
    {{ 'component-countdown-timer.css' | asset_url | stylesheet_tag }}
</noscript>

