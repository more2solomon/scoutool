{%- liquid
    assign sectionId = '#shopify-section-' | append: section.id
    assign title = section.blocks | where: 'type', 'heading' | first
    assign description = section.blocks | where: 'type', 'text' | first
    assign button = section.blocks | where: 'type', 'button' | first

    assign useViewAllButton = false
    if button.settings.view_all_appearance == 'button' or button.settings.view_all_appearance == 'button_secondary'
        assign useViewAllButton = true
    endif

    assign __class__ = 'rich-text'
    assign __class__ = __class__ | append: ' color-' | append: section.settings.color_scheme
    if section.settings.full_width
        assign __class__ = __class__ | append: ' rich-text--full-width'
    else
        assign __class__ = __class__ | append: ' dynamic-page-width'
    endif

    if section.settings.animation_on_reveal
        assign __class__ = __class__ | append: ' reveal-slide-in'
    endif
-%}

{% style %}
    {{ sectionId }} .rich-text {
      width: 100%;
      max-width: {{ section.settings.content_width }}px;
      text-align: {{ section.settings.content_position }};
      margin: auto;
    }
    {% if section.settings.full_width %}
    {{ sectionId }} .rich-text__blocks {
      width: 100%;
      padding: 0 1rem;
    }{% endif %}{% if template == 'index' %}
    {{ sectionId }} .rich-text p {
      font-size: 15px;
      line-height: 160%;{% if section.settings.color_scheme == 'background-1' %}
      color: #5b6577;{% endif %}
    }{% endif %}{% if section.settings.split_content %}
    @media screen and (min-width: 750px) {
      {{ sectionId }} :is(.split--content) {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }{% unless title.settings.custom_heading_size == blank %}
        {{ sectionId }} .rich-text :is(.title) {
          font-size: {{ title.settings.custom_heading_size }}px;{% if title.settings.custom_heading_size > '55' %}
          max-width: 40%;
          line-height: 1.2;{% endif %}
        }
      {% endunless %}
    }{% endif %}
{% endstyle %}

<div class="{{ __class__ }}">
    <div class="rich-text__blocks{% if section.settings.split_content %} split--content{% endif %}">
        {%- unless title.settings.heading == blank -%}
            <{{ title.settings.heading_size }}
                class="title reveal-item{% if settings.show_uppercase_heading %} uppercase{% endif %}"
                {{ title.shopify_attributes }}
            >
                {%- if settings.bold_first_heading_word -%}
                    {% render 'helper__decorate-heading', heading: title.settings.heading %}
                {%- else -%}
                    {{ title.settings.heading }}
                {%- endif -%}
            </{{ title.settings.heading_size }}>
        {%- endunless -%}
        {%- unless description.settings.text == blank -%}
            <div class="rich-text__text rte reveal-item" {{ description.shopify_attributes }}>
                {{ description.settings.text }}
            </div>
        {%- endunless -%}
        {% unless button == null %}
            {%- if button.settings.button_label != blank and button.settings.button_link != blank -%}
                {%- liquid
                    assign button_class = 'view-all reveal-item'
                    case button.settings.view_all_appearance
                        when 'button'
                            assign button_class = button_class | append: ' button button--primary animate-arrow'
                        when 'button_secondary'
                            assign button_class = button_class | append: ' button animate-arrow'
                        when 'link'
                            assign button_class = button_class | append: ' link'
                    endcase
                    if settings.show_button_ring_on_hover
                        assign button_class = button_class | append: ' border--outline'
                    endif
                    if settings.cut_button_corners
                        assign button_class = button_class | append: ' border--with-cut-corners'
                    endif
                -%}
                <a
                    href="{{ button.settings.button_link }}"
                    class="{{ button_class }}"
                    aria-label="{{ 'sections.collection_list.view_all' | t }}"
                    title="{{ 'sections.collection_list.view_all' | t }}"
                >
                    {{ button.settings.button_label | escape }}
                    {% if useViewAllButton and settings.show_icon_arrow -%}
                        {% render 'icons-solid', name: 'arrow-right', css_class: 'icon-arrow' %}
                    {% endif %}
                </a>
            {%- endif -%}
        {% endunless %}
    </div>
</div>

{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}</noscript>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "spaced-section--full-width",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "text",
      "id": "content_width",
      "label": "t:sections.rich-text.settings.content_width.label",
      "info": "px"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.rich-text.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_position.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_position.options.center"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_position.options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "split_content",
      "label": "t:sections.rich-text.settings.split_content.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "animation_on_reveal",
      "label": "t:sections.all.settings.animation_on_reveal.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Talk about your brand",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options.h1"
            },
            {
              "value": "h2",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options.h2"
            },
            {
              "value": "h3",
              "label": "t:sections.rich-text.blocks.heading.settings.heading_size.options.h3"
            }
          ],
          "default": "h2",
          "label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
        },
        {
          "type": "text",
          "id": "custom_heading_size",
          "label": "t:sections.featured-collection.settings.custom_heading_size.label",
          "info": "t:sections.featured-collection.settings.custom_heading_size.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.rich-text.blocks.button.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "view_all_appearance",
          "options": [
            {
              "value": "button",
              "label": "t:sections.rich-text.blocks.button.settings.view_all_appearance.options.button"
            },
            {
              "value": "button_secondary",
              "label": "t:sections.rich-text.blocks.button.settings.view_all_appearance.options.button_secondary"
            },
            {
              "value": "link",
              "label": "t:sections.rich-text.blocks.button.settings.view_all_appearance.options.link"
            }
          ],
          "default": "button",
          "label": "t:sections.rich-text.blocks.button.settings.view_all_appearance.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
