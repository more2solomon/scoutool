{% liquid
    assign useViewAllButton = false
    if section.settings.view_all_appearance == 'button' or section.settings.view_all_appearance == 'button_secondary'
        assign useViewAllButton = true
    endif

    assign button_class = 'view-all reveal-item'
    case section.settings.view_all_appearance
        when 'button'
            assign button_class = button_class | append: ' button button--primary animate-arrow'
        when 'button_secondary'
            assign button_class = button_class | append: ' button animate-arrow'
        when 'link'
            assign button_class = button_class | append: ' link'
    endcase
    if settings.show_button_ring_on_hover
        assign button_class = button_class | append: ' border--outline'
    endif
    if settings.cut_button_corners
        assign button_class = button_class | append: ' border--with-cut-corners'
    endif
%}

{% style %}
    .featured-blog .heading,
    .featured-blog ul {
        display: flex;
        justify-content: space-between;
    }

    .featured-blog .heading {
        align-items: center;
    }

    .featured-blog .article-card__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        position: relative;
        font-weight: 700;
    }

    .featured-blog .article-card__info .date__wrapper {
        display: flex;
        align-items: end;
        padding-top: 1rem;
        padding-bottom: 0.5rem;
    }

    .articles-wrapper .article {
        height: fit-content;
        overflow: hidden;
    }

    .article:has(.loading-overlay) {
        position: relative;
    }

    .article :is(.loading-overlay) {
        z-index: 1;
    }

    .article-card__header .date__wrapper .icon {
        color: var(--color-foreground-50);
        margin-right: 0.5rem;
    }

    .featured-blog .media > img,
    .featured-blog .article-card__image-wrapper > svg {
        border-radius: 4px;
    }

    [data-theme-preset="metalware"] .article-card__published-at {
        color: var(--color-base-accent-1);
    }

    [data-theme-preset="metalware"] .featured-blog .article-card__title {
        font-weight: 400;
    }{%- if section.settings.post_limit == 1 -%}

    .featured-blog .article-content {
        align-items: center;
    }

    .featured-blog .article-card__published-at {
        padding-top: .5rem;
    }

    @media (min-width: 768px), print {
        .featured-blog .article-content:has(.media) .article-card__info {
            padding-left: 1.5rem;
            border-radius: 2px;
            min-width: 22rem;
        }

        .featured-blog .article-card__header {
            display: flex;
            flex-direction: column;
        }
    }{%- endif -%}{%- if section.settings.post_limit > 1 -%}

    .featured-blog article > a {
        display: flex;
        flex-direction: column;
    }

    @media (max-width: 425px), print {
        .featured-blog .articles-wrapper {
            gap: 1rem;
        }
    }

    @media (min-width: 600px), print {
        .featured-blog .no__articles > a {
            flex-direction: column;
        }

        .articles-wrapper .article {
            width: calc(100% /{{ section.settings.post_limit }} - .5rem);
        }
    }{%- endif -%}

    @media (min-width: 600px), print {
        .featured-blog .slider-buttons__container {
            display: none;
        }
    }

    @media screen and (min-width: 989px) {
        .featured-blog article .media > img {
            transition: transform .5s ease;
            image-rendering: pixelated;
        }

        .featured-blog article:hover .media > img {
            transform: scale(1.03);
        }
    }
{% endstyle %}

<div class="featured-blog dynamic-page-width{% if section.settings.animation_on_reveal %} reveal-slide-in{% endif -%}">
    {%- liquid
        assign heading_class = 'heading reveal-item'
        if section.settings.heading == blank
            assign heading_class = heading_class | append: ' title-wrapper-with-link--no-heading'
        endif
        if settings.current_presets == 'metalware'
            assign heading_class = heading_class | append: ' with--metalware-element-design'
        endif
    -%}
    <div class="{{ heading_class }}">
        <{{ section.settings.heading_size }} class="section--title reveal-item{% if settings.show_uppercase_heading %} uppercase{% endif %}">
            {% render 'helper__decorate-heading', heading: section.settings.heading %}
        </{{ section.settings.heading_size }}>
        {%- if section.settings.show_view_all -%}
            <a
                href="{{ section.settings.blog.url }}"
                class="{{ button_class }}"
                aria-label="{{ 'sections.collection_list.view_all' | t }}"
                title="{{ 'sections.collection_list.view_all' | t }}"
            >
                <span>{{ 'sections.featured_blog.view_all' | t }}</span>
                {% if useViewAllButton and settings.show_icon_arrow -%}
                    {% render 'icons-solid', name: 'arrow-right', css_class: 'icon-arrow' %}
                {% endif %}
            </a>
        {%- endif -%}
    </div>

    {%- liquid
        if section.settings.post_limit <= section.settings.blog.articles_count
            assign posts_exceed_limit = true
        endif
    -%}

    <slider-component
        {% if settings.animation_on_reveal %}
            class="reveal-slide-in"
        {% endif %}
        data-loop="false"
    >
        <ul
            class="blog__posts articles-wrapper slider slider--tablet slider--no-controls"
            role="list"
            data-posts="{{ section.settings.post_limit }}"
        >
            {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
                {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
                    <li class="blog__post grid__item article{% if section.settings.post_limit > 1 %} slider__slide{% endif %} reveal-item">
                        {%- capture article_card_html -%}
      {%- render 'article-card',
        blog: section.settings.blog
        article: article
        show_image: section.settings.show_image
        truncate_words: section.settings.truncate_words
        tags_limit: section.settings.tags_limit
        item_link_appearence: section.settings.item_link_appearence
        button_label: section.settings.button_label
      -%}
    {%- endcapture -%}
                        {{ article_card_html | replace: '<h2 class=', '<h3 class=' | replace: '</h2>', '</h3>' }}
                    </li>
                {%- endfor -%}
            {%- else -%}
                {% for itteration in (1..3) limit: section.settings.post_limit %}
                    <li class="blog__post no__articles grid__item article{% if section.settings.post_limit > 1 %} slider__slide{% endif %} reveal-item">
                        {%- capture onboarding_article_card -%}
    <a href="#/" class="article-content">
      {% if section.settings.show_image %}
        <div class="article-card__image-wrapper">
          <div class="article-card__image media" style="padding-bottom: 66.67%">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
      <div class="article-card__info">
      {%- for block in section.blocks -%}
        {% case block.type -%}
          {% when 'title' -%}
              <header class="article-card__header">
                {%- if block.settings.show_date -%}
                <span class="article-card__published-at{% if block.settings.show_text_uppercase %} uppercase{% endif %}">
                  {{ "today" | time_tag: format: 'month_year' }}
                  {%- if block.settings.show_author -%}
                  <span class="article-card__author">
                    {{ "sections.featured_blog.onboarding_author" | t }}
                  </span>
                  {%- endif -%}
                </span>
                {%- endif -%}
                {% if block.settings.show_article_title %}
                  <span class="article-card__title{% if block.settings.show_text_uppercase %} uppercase{% endif %}">
                    {{ 'sections.featured_blog.onboarding_title' | t }}
                  </span>
              {% endif %}
              </header>
          {% when 'summary' -%}
          {% assign limit = block.settings.truncate_words | plus: 0 %}
          {% unless limit == 0 %}
          {% assign onboardingContent =  'sections.featured_blog.onboarding_content' | t | truncatewords: limit %}
            <p class="article-card__excerpt{% if block.settings.show_text_uppercase %} uppercase{% endif %}" style="font-size:{{ block.settings.excerpt_font_size }}px">
              {{ onboardingContent }}
            </p>
          {% endunless %}
        {% endcase %}
      {%- endfor -%}
      </div>
    </a>    
    {%- endcapture -%}
                        {{ onboarding_article_card | replace: '<h2 class=', '<h3 class=' | replace: '</h2>', '</h3>' }}
                    </li>
                {% endfor %}
            {%- endif -%}
        </ul>

        {%- if section.settings.show_mobile_scrollbar -%}
            {% render 'slider-buttons', items: section.settings.blog, section_settings: section.settings %}
        {%- endif -%}
    </slider-component>
</div>

{% schema %}
{
  "name": "t:sections.featured-blog.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Featured recent posts",
      "label": "t:sections.featured-blog.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.featured-blog.settings.heading_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.featured-blog.settings.heading_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.featured-blog.settings.heading_size.options.h3"
        }
      ],
      "default": "h2",
      "label": "t:sections.featured-blog.settings.heading_size.label"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-blog.settings.blog.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_image.label",
      "info": "t:sections.featured-blog.settings.show_image.info"
    },
    {
      "type": "range",
      "id": "tags_limit",
      "label": "t:sections.main-blog.settings.tags_limit.label",
      "default": 3,
      "min": 0,
      "max": 10,
      "step": 1
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.post_limit.label"
    },
    {
      "type": "select",
      "id": "item_link_appearence",
      "label": "Item link appearence",
      "options": [
        {
          "value": "link",
          "label": "t:sections.our-list-collections.settings.item_link_appearence.options.link"
        },
        {
          "value": "button",
          "label": "t:sections.our-list-collections.settings.item_link_appearence.options.button"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.our-list-collections.settings.button_label.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_view_all.label"
    },
    {
      "type": "select",
      "id": "view_all_appearance",
      "options": [
        {
          "value": "button",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.button"
        },
        {
          "value": "button_secondary",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.button_secondary"
        },
        {
          "value": "link",
          "label": "t:sections.featured-collection.settings.view_all_appearance.options.link"
        }
      ],
      "default": "link",
      "label": "t:sections.featured-collection.settings.view_all_appearance.label"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_scrollbar",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_mobile_scrollbar.label"
    },
    {
      "type": "select",
      "id": "slideshow_ui_type",
      "options": [
        {
          "value": "buttons",
          "label": "t:sections.featured-collection.settings.slideshow_ui_type.options.buttons"
        },
        {
          "value": "scrollbar",
          "label": "t:sections.featured-collection.settings.slideshow_ui_type.options.scrollbar"
        }
      ],
      "default": "buttons",
      "label": "t:sections.featured-collection.settings.slideshow_ui_type.label"
    },
    {
      "type": "checkbox",
      "id": "animation_on_reveal",
      "label": "t:sections.all.settings.animation_on_reveal.label",
      "default": true
    }
  ],
  "max_blocks":2,
  "blocks": [
    {
      "type": "title",
      "name": "t:sections.featured-blog.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "title_size",
          "min":16,
          "max": 36,
          "step": 2,
          "default": 24,
          "unit": "t:sections.featured-blog.blocks.title.settings.title_size.unit",
          "label": "t:sections.featured-blog.blocks.title.settings.title_size.label"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "default": true,
          "label": "t:sections.featured-blog.blocks.title.settings.show_date.label"
        },
        {
          "type": "select",
          "id": "date_format",
          "label": "t:sections.featured-blog.blocks.title.settings.date_format.label",
          "options": [
            {
              "value": "day_month_year",
              "label": "t:sections.featured-blog.blocks.title.settings.date_format.options.day_month_year"
            },
            {
              "value": "year_month_day",
              "label": "t:sections.featured-blog.blocks.title.settings.date_format.options.year_month_day"
            },
            {
              "value": "month_year",
              "label": "t:sections.featured-blog.blocks.title.settings.date_format.options.month_year"
            }
          ],
          "default": "month_year"
        },
        {
          "type": "checkbox",
          "id": "show_icon_calendar",
          "label": "t:sections.featured-blog.blocks.title.settings.show_icon_calendar.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "default": false,
          "label": "t:sections.featured-blog.blocks.title.settings.show_author.label"
        },
        {
          "type": "checkbox",
          "id": "show_article_title",
          "default": true,
          "label": "t:sections.featured-blog.blocks.title.settings.show_article_title.label"
        },
        {
          "type": "checkbox",
          "id": "show_text_uppercase",
          "label": "t:sections.featured-blog.blocks.title.settings.show_text_uppercase.label",
          "default": false
        }
      ]
    },
    {
      "type": "summary",
      "name": "t:sections.featured-blog.blocks.summary.name",
      "limit": 1,
      "settings": [
        {
          "type":"text",
          "id": "truncate_words",
          "label":"t:sections.featured-blog.blocks.summary.settings.truncate_words",
          "default": "30"
        },
        {
          "type": "range",
          "id": "excerpt_font_size",
          "min": 16,
          "step": 1,
          "max": 22,
          "default": 16,
          "label": "t:sections.featured-blog.blocks.summary.settings.excerpt_font_size"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-blog.presets.name",
      "settings": {
        "blog": "News"
      },
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "summary"
        }
      ]
    }
  ]
}
{% endschema %}
