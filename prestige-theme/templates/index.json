        "about_content": {
          "type": "richtext",
          "settings": {
            "content": "<p>At Velvet Journal Co, we create thoughtfully designed journals and planners that help you stay organized, set meaningful goals, and capture life as it happens. Every page is made to slow you down, clear your mind, and keep what matters close.</p>"
          }
        },
