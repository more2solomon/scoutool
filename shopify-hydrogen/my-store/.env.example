# --- Shopify Storefront (already configured) ---
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
SHOPIFY_API_VERSION=2026-07
NEXT_PUBLIC_SITE_URL=https://www.velvetjournalco.store

# --- Shopify Admin (Settings → Dev Dashboard → app → client ID/secret) ---
# Scopes: read_products,write_products,read_orders,write_orders,read_inventory,
#         write_inventory,read_customers,write_customers,read_draft_orders,write_draft_orders
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Or a legacy admin token (shpat_...) — overrides client credentials if set
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Grey (business dashboard → Integrations → API keys) ---
GREY_API_SECRET_KEY=gbsk_...
GREY_ENV=production
GREY_WEBHOOK_SECRET=
# Account details shown to customers at checkout (from your Grey dashboard)
GREY_ACCOUNT_HOLDER=
GREY_ACCOUNT_BANK_NAME=
GREY_ACCOUNT_NUMBER=
GREY_ACCOUNT_ROUTING=
GREY_ACCOUNT_SWIFT=
GREY_ACCOUNT_COUNTRY=US
GREY_CURRENCY=USD

# --- CJ Dropshipping (cjdropshipping.com → My CJ → API) ---
CJ_API_KEY=

# --- Dropshipping pricing defaults for scripts/import-cj-products.mjs ---
DROPSHIP_MARKUP=3
DROPSHIP_MIN_PRICE=19.99

# --- Legacy Paystack (optional, currently unused) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=USD
NEXT_PUBLIC_PAYMENTS_LIVE=false

# --- Flutterwave (dashboard.flutterwave.com → Settings → API Keys) ---
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_CURRENCY=USD
FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoney,banktransfer
FLUTTERWAVE_PAYMENT_TITLE=Velvet Journal Co
FLUTTERWAVE_API_BASE=https://api.flutterwave.com/v3
# Secret hash set in Flutterwave → Settings → Webhooks (sent as verif-hash)
FLUTTERWAVE_WEBHOOK_SECRET=
# Webhook URL to register: https://www.velvetjournalco.store/api/flutterwave/webhook

# --- Payment intent signing (keeps checkout amounts tamper-proof) ---
PAYMENT_INTENT_SECRET=

# --- Loyalty rewards (optional overrides) ---
# Every 10th order earns 50% off, the 100th earns 75% off. Values live in lib/loyalty.ts
